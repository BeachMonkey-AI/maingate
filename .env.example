# Copy to .env for local development. Never commit the real .env.

# Enables Gemini-based intent parsing. Unset -> falls back to a
# deterministic rule-based parser (used automatically in tests).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Cloud project number of *this* Cloud Run service (not MainGate's data
# project). Required to verify that requests to /chat actually came from
# Google Chat. Unset -> requests are accepted unverified (fine for local
# dev, not for anything internet-reachable).
GOOGLE_CHAT_PROJECT_NUMBER=

# "firestore" is a documented Phase 2 target, not implemented in this PoC.
DATA_STORE=json
DATA_FILE=./data/sample-data.json

PORT=8080
