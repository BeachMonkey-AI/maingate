# Copy to .env for local development. Never commit the real .env.

# Required — the service has no non-Gemini fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Used to verify requests to /chat really came from Google Chat. Set the
# project number of the project the CHAT APP is registered in (596520922206) —
# not the project the Cloud Run service runs in. GOOGLE_CHAT_AUDIENCE is the
# deployed endpoint URL; tokens carry one or the other depending on how the app
# is registered, so both are accepted. With neither set, requests are accepted
# unverified — fine locally, not for anything internet-reachable.
GOOGLE_CHAT_PROJECT_NUMBER=
GOOGLE_CHAT_AUDIENCE=

# Path to the operational dataset JSON (read once, then cached).
DATA_FILE=./data/sample-data.json

PORT=8080
